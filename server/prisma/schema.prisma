// Prisma Schema for SunGrid Renewables Customer Return Exception Control
// Optimized for Neon-hosted PostgreSQL with Connection Pooling & Direct Migration URLs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  RETURNS_ANALYST
  RETURNS_MANAGER
  FINANCE_APPROVER
  ADMIN
}

enum UserAccountStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id                    String            @id @default(uuid())
  name                  String
  email                 String            @unique
  passwordHash          String
  role                  UserRole          @default(RETURNS_ANALYST)
  status                UserAccountStatus @default(APPROVED)
  department            String?
  designation           String?
  employeeId            String?
  isActive              Boolean           @default(true)
  approvedAt            DateTime?
  approvedById          String?
  passwordResetToken    String?
  passwordResetExpires  DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  assignedReturns           ReturnRecord[]           @relation("AssignedOwner")
  createdReturns            ReturnRecord[]           @relation("CreatedReturns")
  comments                  ReturnComment[]
  attachments               Attachment[]
  requestedApprovals        Approval[]               @relation("RequestedBy")
  decidedApprovals          Approval[]               @relation("DecidedBy")
  auditLogs                 AuditLog[]
  notifications             Notification[]
  recommendationFeedbacks   RecommendationFeedback[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model ReturnRecord {
  id                     String    @id
  returnOrder            String
  sapDocument            String    @unique
  companyCode            String    @default("1300")
  plant                  String
  plantName              String?
  storageLocation        String
  storageLocationName    String?
  costCenter             String
  costCenterName         String?
  material               String
  materialId             String?
  businessPartner        String?
  businessPartnerRaw     String?
  businessPartnerName    String?
  currency               String    @default("GBP")
  amount                 Decimal   @db.Decimal(12, 2)
  requestedDate          DateTime
  processingStatus       String    @default("Unassigned")
  exceptionType          String?
  exceptionDescription   String?
  exceptionCategory      String?
  primaryExceptionReason String?
  assignedOwner          String?
  assignedOwnerId        String?
  assignedUser           User?     @relation("AssignedOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  createdById            String?
  createdUser            User?     @relation("CreatedReturns", fields: [createdById], references: [id], onDelete: SetNull)
  riskLevel              String    @default("LOW")
  riskScore              Int       @default(0)
  riskReasons            String[]
  isPrimaryReference     Boolean   @default(false)
  deliveryDocument       String?
  goodsReceiptStatus     String?
  billingBlock           String?
  creditMemoDoc          String?
  recommendedAction      String?
  resolutionNotes        String?
  isArchived             Boolean   @default(false)
  archivedAt             DateTime?
  archivedById           String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  comments                ReturnComment[]
  attachments             Attachment[]
  approvals               Approval[]
  timeline                ReturnEvent[]
  auditLogs               AuditLog[]
  recommendationFeedbacks RecommendationFeedback[]

  @@index([sapDocument])
  @@index([plant])
  @@index([processingStatus])
  @@index([riskLevel])
  @@index([assignedOwnerId])
  @@index([isArchived])
}

model ReturnComment {
  id             String       @id @default(uuid())
  returnRecordId String
  returnRecord   ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  author         String
  persona        String?
  text           String
  timestamp      DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([returnRecordId])
}

model Attachment {
  id             String       @id @default(uuid())
  returnRecordId String
  returnRecord   ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  fileName       String
  fileSize       Int
  mimeType       String
  fileUrl        String
  uploadedById   String?
  uploadedBy     User?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedByName String?
  createdAt      DateTime     @default(now())

  @@index([returnRecordId])
}

model Approval {
  id              String       @id @default(uuid())
  returnRecordId  String
  returnRecord    ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  requestedById   String?
  requestedBy     User?        @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  approverId      String?
  approver        User?        @relation("DecidedBy", fields: [approverId], references: [id], onDelete: SetNull)
  actionType      String       // APPROVE, REJECT, REQUEST_APPROVAL
  approvalStatus  String       @default("PENDING") // PENDING, APPROVED, REJECTED
  decisionComment String?
  decidedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([returnRecordId])
  @@index([approvalStatus])
}

model ReturnEvent {
  id             String       @id @default(uuid())
  returnRecordId String
  returnRecord   ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  step           String
  timestamp      String       // Storing original formatted timestamp string e.g. "2026-08-13 09:15"
  actor          String
  status         String
  docRef         String?
  sapTx          String?
  detail         String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([returnRecordId])
}

model AuditLog {
  id             String        @id
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  actor          String
  persona        String
  recordId       String?
  returnRecord   ReturnRecord? @relation(fields: [recordId], references: [id], onDelete: SetNull)
  sapDocument    String?
  action         String
  fieldChanged   String?
  oldValue       String?
  newValue       String?
  reason         String?
  source         String        @default("Resolution Workspace")
  sapReference   String?
  ipAddress      String?
  timestamp      String        // Original formatted timestamp string e.g. "2026-10-28 02:35:57"
  createdAt      DateTime      @default(now())

  @@index([recordId])
  @@index([sapDocument])
  @@index([action])
  @@index([persona])
}

model Notification {
  id               String   @id @default(uuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  message          String
  notificationType String  // CRITICAL, HIGH, INFO
  isRead           Boolean  @default(false)
  relatedReturnId  String?
  rule             String?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([relatedReturnId])
}

model RecommendationFeedback {
  id                     String       @id @default(uuid())
  returnRecordId         String
  returnRecord           ReturnRecord @relation(fields: [returnRecordId], references: [id], onDelete: Cascade)
  recommendation         String
  confidence             String?
  recommendationEvidence String[]
  userDecision           String       // ACCEPTED, EDITED, REJECTED
  feedbackComment        String?
  revisedAction          String?
  userId                 String?
  user                   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  decidedBy              String?
  decidedAt              DateTime?
  createdAt              DateTime     @default(now())

  @@index([returnRecordId])
}
